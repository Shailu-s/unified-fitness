{
  "expo": {
    "name": "uni-fit",
    "slug": "uni-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [["expo-image-picker", {
      "cameraPermission": "Allow Unified Fitness to photograph your meals.",
      "photosPermission": "Allow Unified Fitness to choose a meal photo.",
      "microphonePermission": false
    }]],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ritik.unifiedfitness"
    },
    "android": {
      "package": "com.ritik.unifiedfitness",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}
