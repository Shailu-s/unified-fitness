{
  "name": "uni-fit",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --go --port 8082",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "start:dev": "expo start --dev-client --port 8083",
    "ios:device": "expo run:ios --device --port 8083",
    "android:device": "expo run:android --device --port 8083",
    "native:generate": "expo prebuild --no-install --no-clean --skip-dependency-update react,react-native --template expo-template-bare-minimum@57.0.26",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "expo": "57.0.26",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "^57.0.4",
    "expo-sharing": "57.0.22",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
