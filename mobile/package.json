{
  "name": "uni-fit",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "yarn check:config && expo start --go --port 8082",
    "android": "yarn check:config && expo start --go --android",
    "ios": "yarn check:config && expo start --go --ios",
    "web": "yarn check:config && expo start --web",
    "start:dev": "yarn check:config && expo start --dev-client --port 8083",
    "ios:device": "yarn check:config && expo run:ios --device --port 8083",
    "android:device": "yarn check:config && expo run:android --device --port 8083",
    "native:generate": "yarn check:config && expo prebuild --no-install --no-clean --skip-dependency-update react,react-native --template expo-template-bare-minimum@57.0.26",
    "check:config": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local scripts/check-public-config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@supabase/supabase-js": "2.117.2",
    "expo": "57.0.26",
    "expo-audio": "57.0.5",
    "expo-camera": "57.0.6",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "^57.0.4",
    "expo-image-manipulator": "57.0.20",
    "expo-image-picker": "57.0.20",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
